{{ define "randoli.email.subject" -}}
[{{ .CommonLabels.severity | toUpper }}] {{ .CommonLabels.alertName }}{{ with .CommonLabels.resource }} on {{ . }}{{ end }}{{ with .CommonLabels.dataPlane }} ({{ . }}){{ end }}
{{- end }}

{{ define "randoli.email.body" }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <style>
    body { margin:0; padding:0; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
    table { border-collapse:collapse; }
    img { border:0; outline:none; text-decoration:none; }
  </style>
</head>
<body style="margin:0; padding:0; font-family: Arial, Helvetica, sans-serif; background-color:#eef0f2;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; background-color:#eef0f2;">
    <tr>
      <td align="center" style="padding:12px 10px;">

        <!--[if mso]><table role="presentation" width="660" align="center" cellpadding="0" cellspacing="0"><tr><td><![endif]-->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
               style="width:100%; max-width:660px; background-color:#ffffff; border-radius:14px; overflow:hidden; border:1px solid #eaecef;">

          <!-- Accent bar -->
          <tr>
            <td style="background-color:{{ template "randoli.common.severityBar" .CommonLabels.severity }}; height:5px; font-size:0; line-height:0;">&nbsp;</td>
          </tr>

          <!-- Severity band: light tint, badge aligned right -->
          <tr>
            <td align="right" style="background-color:{{ template "randoli.common.severityTint" .CommonLabels.severity }}; border-bottom:1px solid {{ template "randoli.common.severityBg" .CommonLabels.severity }}; padding:6px 20px; line-height:1;">
              <span style="display:inline-block; padding:5px 12px; border-radius:6px; background-color:{{ template "randoli.common.severityBg" .CommonLabels.severity }}; color:{{ template "randoli.common.severityFg" .CommonLabels.severity }}; font-size:12px; font-weight:700; letter-spacing:0.04em; line-height:1.2;">
                {{ .CommonLabels.severity | toUpper }}
              </span>
            </td>
          </tr>

          <!-- Alert header: fixed-size icon cell, spacer cell, then the title -->
          <tr>
            <td style="padding:16px 20px;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;">
                <tr>
                  <td width="40" valign="middle" style="width:40px; min-width:40px; vertical-align:middle; padding:0;">
                    <img src="https://cdn.prod.website-files.com/66e2aa7f74a05584d1dc32d8/67b4ede66602c10c41838925_logo_48px.png"
                         width="40" height="40" alt="" style="display:block; width:40px; height:40px; max-width:none;">
                  </td>
                  <td width="12" style="width:12px; min-width:12px; padding:0; font-size:0; line-height:0;">&nbsp;</td>
                  <td valign="middle" style="vertical-align:middle; padding:0; font-size:19px; font-weight:700; color:#14171a; line-height:1.3; word-wrap:break-word; overflow-wrap:break-word; word-break:break-word;">
                    {{ .CommonLabels.alertName }}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:0 20px;">
              <hr style="border:none; border-top:1px solid #eceef1; margin:0;">
            </td>
          </tr>

          <!-- Alert details -->
          <tr>
            <td style="padding:16px 20px 4px 20px;">
              {{ with .CommonAnnotations.description }}
              <p style="margin:0 0 16px 0; font-size:15px; line-height:1.6; color:#4b5560; word-wrap:break-word; overflow-wrap:break-word; word-break:break-word;">{{ . }}</p>
              {{ end }}

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border:1px solid #eceef1; border-radius:10px; margin-bottom:20px;">
                <tr>
                  <td style="padding:10px 16px; border-bottom:1px solid #eceef1;">
                    {{ template "randoli.common.icon.details" . }}<span style="font-size:13px; font-weight:700; color:#0e6e8c; letter-spacing:0.04em; vertical-align:middle;">DETAILS</span>
                  </td>
                </tr>
                <tr>
                  <td style="padding:2px 16px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

                      {{ with .CommonLabels.dataPlane }}
                      <tr>
                        <td style="padding:6px 12px 6px 0; border-bottom:1px solid #f0f1f3; font-size:12px; color:#9aa1ab; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; white-space:nowrap; vertical-align:baseline;">Data Plane</td>
                        <td align="right" style="padding:6px 0; border-bottom:1px solid #f0f1f3; font-size:14px; color:#232629; font-weight:500; word-wrap:break-word; overflow-wrap:break-word; word-break:break-word; vertical-align:baseline;">{{ . }}</td>
                      </tr>
                      {{ end }}

                      {{ template "randoli.email.details.rows" . }}

                      {{ with .CommonAnnotations.occurredAt }}
                      <tr>
                        <td style="padding:6px 12px 6px 0; font-size:12px; color:#9aa1ab; font-weight:600; text-transform:uppercase; letter-spacing:0.04em; white-space:nowrap; vertical-align:baseline;">Occurred At</td>
                        <td align="right" style="padding:6px 0; font-size:14px; color:#232629; font-weight:500; word-wrap:break-word; overflow-wrap:break-word; word-break:break-word; vertical-align:baseline;">{{ . }}</td>
                      </tr>
                      {{ end }}

                    </table>
                  </td>
                </tr>
              </table>

              {{ with .CommonAnnotations.sourceUrl }}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 0;">
                <tr>
                  <td align="center">
                    <a href="{{ . }}"
                       style="display:block; max-width:240px; margin:0 auto; padding:14px 24px; background-color:#0e6e8c; color:#ffffff; text-decoration:none; border-radius:8px; font-weight:600; font-size:15px; text-align:center; box-sizing:border-box;">
                      View in Console
                    </a>
                  </td>
                </tr>
              </table>
              {{ end }}
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#f8f9fa; padding:14px 20px 16px 20px; font-size:12px; line-height:1.5; color:#838b96; text-align:center; border-top:1px solid #f0f1f3;">
              This is an automated notification from Randoli App Insights. Please do not reply.
            </td>
          </tr>

        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
{{ end }}