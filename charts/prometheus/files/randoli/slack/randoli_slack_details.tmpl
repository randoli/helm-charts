{{ define "randoli.slack.details" -}}
{{- $m := index .CommonLabels "module" | toLower -}}
{{- if eq $m "kube" -}}
{{- template "randoli.slack.details.kube" . -}}
{{- else if eq $m "otel" -}}
{{- template "randoli.slack.details.otel" . -}}
{{- else -}}
{{- template "randoli.slack.details.default" . -}}
{{- end }}
{{- end }}

{{/* kube: the kind label (Node, Pod, Deployment, ...) names the line; default "Resource". */}}
{{ define "randoli.slack.details.kube" -}}
{{- with .CommonAnnotations.namespace }}
*Namespace:* {{ . }}
{{- end }}
{{- with .CommonLabels.resource -}}
{{- $label := "Resource" -}}
{{- with $.CommonLabels.kind -}}
{{- $label = . -}}
{{- end }}
*{{ $label }}:* {{ . }}
{{- end -}}
{{- end }}

{{/* otel: kind names the line when present; otherwise "Service Name". */}}
{{ define "randoli.slack.details.otel" -}}
{{- with .CommonLabels.resource -}}
{{- $label := "Service Name" -}}
{{- with $.CommonLabels.kind -}}
{{- $label = . -}}
{{- end }}
*{{ $label }}:* {{ . }}
{{- end -}}
{{- end }}

{{/* Fallback: alerts without a known module label get a plain Resource line. */}}
{{ define "randoli.slack.details.default" -}}
{{- with .CommonLabels.resource }}
*Resource:* {{ . }}
{{- end -}}
{{- end }}
